{
  "command": "node",
  "args": ["main.mjs"],
  "restart_policy": "always",
  "display_name": "Open In App",
  "description": "Automatically detect the active Antigravity 2.0 workspace/worktree and open it in VS Code, Trae CN, GoLand, PyCharm, or Winc.",
  "has_web_ui": true,
  "agent_permissions": {
    "allows_user_interactions": true
  },
  "ui_config": {
    "display_name": "Open In App",
    "views": [
      {
        "path": "/",
        "entrypoint": "SIDECAR_UI_ENTRYPOINT_AUX_PANE",
        "title": "Open In App"
      }
    ]
  }
}
